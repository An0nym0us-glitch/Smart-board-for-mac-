# Install-time script (macOS): makes the installed ClassBoard.app self-contained.
#
#  1. macdeployqt copies the Qt frameworks, plug-ins and every other non-system library the
#     app (and, if present, Contents/MacOS/pdftoppm) needs into the bundle.
#  2. Library search paths (LC_RPATH) that point outside the bundle are removed. Some
#     Homebrew libraries keep one into /opt/homebrew/Cellar; on a Mac with Homebrew it could
#     load a different copy of a library than the one shipped.
#  3. The bundle is signed again: macdeployqt and install_name_tool invalidate signatures, and
#     Apple silicon refuses to run code whose signature does not match.
#
# Set by the install(CODE) block in Packaging.cmake: CLASSBOARD_MACDEPLOYQT,
# CLASSBOARD_CODESIGN_IDENTITY.

set(_app "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/ClassBoard.app")
if(NOT EXISTS "${_app}/Contents/MacOS/ClassBoard")
    message(FATAL_ERROR "${_app} was not installed")
endif()
if(NOT CLASSBOARD_MACDEPLOYQT)
    message(FATAL_ERROR "macdeployqt was not found next to the Qt this build uses")
endif()

set(_args "${_app}" -always-overwrite)
if(EXISTS "${_app}/Contents/MacOS/pdftoppm")
    list(APPEND _args "-executable=${_app}/Contents/MacOS/pdftoppm")
endif()
message(STATUS "macdeployqt ${_args}")
execute_process(COMMAND "${CLASSBOARD_MACDEPLOYQT}" ${_args} RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "macdeployqt failed (${_rc})")
endif()

# macdeployqt only follows absolute library references. Libraries that load others through
# @rpath (Homebrew's brotli: libbrotlidec -> @rpath/libbrotlicommon) are copied here, from the
# Qt / Homebrew / MacPorts library folders, until nothing referenced is missing.
set(_frameworks "${_app}/Contents/Frameworks")
set(_search ${CLASSBOARD_LIBRARY_DIRS} /opt/homebrew/lib /usr/local/lib /opt/local/lib)
set(_round 0)
while(TRUE)
    set(_copied FALSE)
    file(GLOB_RECURSE _bins LIST_DIRECTORIES false "${_app}/Contents/*")
    foreach(_bin IN LISTS _bins)
        if(IS_SYMLINK "${_bin}")
            continue()
        endif()
        execute_process(COMMAND otool -L "${_bin}" OUTPUT_VARIABLE _out ERROR_QUIET RESULT_VARIABLE _rc)
        if(NOT _rc EQUAL 0 OR NOT _out MATCHES "@rpath/")
            continue()
        endif()
        string(REGEX MATCHALL "\n[ \t]+@rpath/[^ \t\n]+" _refs "${_out}")
        foreach(_ref IN LISTS _refs)
            string(STRIP "${_ref}" _ref)
            string(REPLACE "@rpath/" "" _name "${_ref}")
            if(EXISTS "${_frameworks}/${_name}")
                continue()
            endif()
            if(_name MATCHES "/")
                message(FATAL_ERROR "${_bin} needs ${_ref}, which macdeployqt did not deploy")
            endif()
            set(_src "")
            foreach(_dir IN LISTS _search)
                if(EXISTS "${_dir}/${_name}")
                    set(_src "${_dir}/${_name}")
                    break()
                endif()
            endforeach()
            if(NOT _src)
                message(FATAL_ERROR "${_bin} needs ${_ref}; it is in none of: ${_search}")
            endif()
            get_filename_component(_real "${_src}" REALPATH)
            message(STATUS "Copying ${_real} (needed by ${_bin}) to Frameworks/${_name}")
            set(_dst "${_frameworks}/${_name}")
            execute_process(COMMAND cp "${_real}" "${_dst}" RESULT_VARIABLE _rc)
            if(NOT _rc EQUAL 0)
                message(FATAL_ERROR "Could not copy ${_real}")
            endif()
            execute_process(COMMAND chmod u+w "${_dst}")
            execute_process(COMMAND install_name_tool -id "@rpath/${_name}" "${_dst}" ERROR_QUIET)
            # Its own absolute references to non-system libraries become @rpath ones; the next
            # round copies those too (from the folder they were in).
            execute_process(COMMAND otool -L "${_dst}" OUTPUT_VARIABLE _deps)
            string(REGEX MATCHALL "\n[ \t]+/[^ \t\n]+" _abs "${_deps}")
            foreach(_dep IN LISTS _abs)
                string(STRIP "${_dep}" _dep)
                if(_dep MATCHES "^/(usr/lib|System)/")
                    continue()
                endif()
                get_filename_component(_depname "${_dep}" NAME)
                get_filename_component(_depdir "${_dep}" DIRECTORY)
                list(APPEND _search "${_depdir}")
                execute_process(COMMAND install_name_tool -change "${_dep}" "@rpath/${_depname}" "${_dst}")
            endforeach()
            set(_copied TRUE)
        endforeach()
    endforeach()
    if(NOT _copied)
        break()
    endif()
    math(EXPR _round "${_round} + 1")
    if(_round GREATER 10)
        message(FATAL_ERROR "Library dependencies did not settle after 10 rounds")
    endif()
endwhile()

file(GLOB_RECURSE _files LIST_DIRECTORIES false "${_app}/Contents/*")
foreach(_file IN LISTS _files)
    if(IS_SYMLINK "${_file}")
        # Framework links whose target macdeployqt did not copy (e.g. Headers) make
        # "codesign --verify --strict" fail; they are of no use in an app bundle.
        if(NOT EXISTS "${_file}")
            message(STATUS "Removing broken link ${_file}")
            file(REMOVE "${_file}")
        endif()
        continue()
    endif()
    execute_process(COMMAND otool -l "${_file}" OUTPUT_VARIABLE _loads ERROR_QUIET RESULT_VARIABLE _rc)
    if(NOT _rc EQUAL 0 OR NOT _loads MATCHES "LC_RPATH")
        continue() # not a Mach-O file, or nothing to clean
    endif()
    string(REGEX MATCHALL "cmd LC_RPATH[^\n]*\n[^\n]*\n *path [^ \n]+" _entries "${_loads}")
    foreach(_entry IN LISTS _entries)
        string(REGEX REPLACE ".*path ([^ \n]+)$" "\\1" _rpath "${_entry}")
        if(NOT _rpath MATCHES "^@(executable|loader)_path")
            message(STATUS "Removing search path ${_rpath} from ${_file}")
            execute_process(COMMAND install_name_tool -delete_rpath "${_rpath}" "${_file}" RESULT_VARIABLE _rc)
            if(NOT _rc EQUAL 0)
                message(FATAL_ERROR "install_name_tool -delete_rpath ${_rpath} ${_file} failed")
            endif()
        endif()
    endforeach()
endforeach()

# Qt (the official builds and Homebrew's) names its libraries @rpath/..., and macdeployqt
# keeps those references. With the outside search paths gone, point the executables and the
# plug-ins at the bundle's Frameworks folder.
function(_classboard_add_rpath file rpath)
    execute_process(COMMAND otool -l "${file}" OUTPUT_VARIABLE _loads ERROR_QUIET)
    string(FIND "${_loads}" "path ${rpath} " _found)
    if(_found EQUAL -1)
        message(STATUS "Adding search path ${rpath} to ${file}")
        execute_process(COMMAND install_name_tool -add_rpath "${rpath}" "${file}" RESULT_VARIABLE _rc)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "install_name_tool -add_rpath ${rpath} ${file} failed")
        endif()
    endif()
endfunction()
foreach(_exe ClassBoard pdftoppm)
    if(EXISTS "${_app}/Contents/MacOS/${_exe}")
        _classboard_add_rpath("${_app}/Contents/MacOS/${_exe}" "@executable_path/../Frameworks")
    endif()
endforeach()
file(GLOB _plugins "${_app}/Contents/PlugIns/*/*.dylib")
foreach(_plugin IN LISTS _plugins)
    _classboard_add_rpath("${_plugin}" "@loader_path/../../Frameworks")
endforeach()

if(CLASSBOARD_CODESIGN_IDENTITY STREQUAL "-")
    set(_sign codesign --force --deep --timestamp=none --sign -)
else()
    set(_sign codesign --force --deep --options runtime --timestamp --sign "${CLASSBOARD_CODESIGN_IDENTITY}")
endif()
execute_process(COMMAND ${_sign} "${_app}" RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "codesign failed (${_rc})")
endif()
